---
import { getCollection, getEntry } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";

const baseUrl = import.meta.env.BASE_URL;
// 取得所有修正歷程檔案
const allAmendments = await getCollection("amendments");

// 提取出有修法紀錄的獨特法規 ID (target_act)
const uniqueActIds = [
  ...new Set(allAmendments.map((amend) => amend.data.target_act)),
].sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));

// 查詢這些法規的詳細資料以供顯示
const actsWithAmendments = await Promise.all(
  uniqueActIds.map(async (id) => {
    const act = await getEntry("act", id);
    // 計算該法規共有幾次修法紀錄
    const count = allAmendments.filter((a) => a.data.target_act === id).length;
    return {
      id,
      title: act?.data.title || id,
      abbr: act?.data.abbr || "",
      count,
    };
  }),
);
---

<MainLayout title="修法沿革">
  <header class="mb-8 pb-0">
    <!-- border-b-2 border-base-300  -->
    <div class="breadcrumbs text-base-content/80 mb-4 text-sm">
      <ul>
        <li>修法沿革</li>
      </ul>
    </div>

    <h2 class="page-title">修法沿革</h2>
    <p class="text-base-content/70">
      ※ 本頁面如與學生議會修法沿革不同，以學生議會公告版本為主。
    </p>
  </header>

  <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
    <!-- md:grid-cols-2 -->

    {
      actsWithAmendments.map((act) => (
        <a
          href={`/laws/amendments/${act.id}`}
          class="bg-base-100 border-base-200 hover:border-neutral/50 hover:bg-base-200/40 flex flex-col justify-between rounded-2xl border p-5 transition duration-300 sm:flex-row sm:items-center dark:hover:border-white"
        >
          <div class="flex-1">
            <h3 class="text-base-content mb-1 truncate text-lg font-semibold">
              {act.abbr}
            </h3>
          </div>
          <div class="mt-4 flex-shrink-0 sm:mt-0 sm:ml-6">
            <span class="badge badge-sm md:badge-md badge-dash">
              修正 {act.count} 次
            </span>
            <span class="icon-[tabler--chevron-right] text-base-content/40 ml-2 align-middle" />
          </div>
        </a>
      ))
    }

    {
      actsWithAmendments.length === 0 && (
        <div class="bg-base-200 text-base-content/60 col-span-full rounded-xl p-8 text-center">
          目前系統中尚無任何法規修正紀錄。
        </div>
      )
    }
  </div>

  <div class="mt-4 grid">
    <a class="btn btn-sm btn-outline btn-wide mx-auto mt-2" href={baseUrl}
      >回首頁</a
    >
  </div>
</MainLayout>

