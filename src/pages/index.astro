---
import MainLayout from '@layouts/MainLayout.astro';
import LawListSection from '@components/LawListSection.astro';
import HomePageRemarks from '@components/HomePageRemarks.astro';
import FeaturedCarousel from '@components/FeaturedCarousel.astro';
import { getCollection } from 'astro:content';
import { lawSections } from '../laws.js'; // 引入法規清單 JSON 資料

// 取得首頁顯示的文章（showInHomePage: true 且非草稿）
const homePagePosts = (await getCollection('blog', ({ data }) => data.showInHomePage && !data.draft))
  .sort((a, b) => {
    // pinned 優先排在最前面
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    const dateA = a.data.modDate || a.data.pubDate;
    const dateB = b.data.modDate || b.data.pubDate;
    return dateB.getTime() - dateA.getTime();
  })
  .map((post) => ({
    slug: post.data.slug,
    title: post.data.title,
    pubDate: post.data.pubDate,
    modDate: post.data.modDate,
    description: post.data.description,
    tags: post.data.tags,
    pinned: post.data.pinned,
  }));

// 聲明文字
const remarksText = `
- 法規條文有數項時，為方便閱讀，於每項前以羅馬數字增冠項次編號；若法規條文僅單項時，則不冠項次編號。
- 本網站自治法規資料，係由本會學生議會提供之電子檔或書面文字登打製作。若與會長令或學生議會之公布文字有所不同，仍以該法規之會長令或學生議會之公布資料為準。
- 本網站之內容不定期更新，最新公告施行法規，將於完成法規整編作業後更新上線。如需查詢最新法規，請至[本會學生議會網站](https://sites.google.com/a/stu.nknush.kh.edu.tw/ashs_sp/laws/法規彙編)查詢。
- 本網站節選部分本校校務章則，實際內容請依[本校官網「校務章則」](https://sites.google.com/tea.nknush.kh.edu.tw/fagui/)或學生手冊查詢為準。
`;
---

<MainLayout title="總覽">
    
    <h2 class="page-title">總覽</h2>

    <!-- 目次 -->
    {lawSections.map((section) => (
        <LawListSection 
            title={section.title} 
            items={section.items} 
        />
    ))}

    <!-- 法規歷程入口 -->
    <!-- <h3 class="page-subtitle">修法歷程</h3> -->
    <!-- <div class="w-full flex justify-center items-center ">
        <a href="/laws/amendments" class="btn btn-wide mx-auto">進入修法歷程</a>
    </div> -->

    <!-- <div class="divider mt-12"></div> -->
    
    <h3 class="page-subtitle">聲明</h3>
    <HomePageRemarks rawText={remarksText} />

    <!-- 首頁文章輪播 -->
    <FeaturedCarousel posts={homePagePosts} />

</MainLayout>