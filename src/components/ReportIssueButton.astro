---
// src/components/ReportIssueButton.astro
// 框選 .regulation-content 文字後彈出的「回報問題」浮動按鈕
---

<!-- 回報問題按鈕 -->
<button 
    id="report-issue-btn" 
    class="btn btn-sm fixed bottom-36 left-0 rounded-l-none toc:rounded-lg toc:top-24 toc:left-auto toc:right-18 z-255 toc:z-50 shadow-md border-none backdrop-blur transition-transform duration-300 -translate-x-full toc:translate-x-0 toc:hidden print:hidden bg-warning/65 dark:bg-warning/65 text-warning-content toc:bg-neutral toc:text-neutral-content"
>
    <span class="grid grid-cols-[auto_1fr] items-center gap-1.5">
        <!-- <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z" />
        </svg> -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4"  fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3v1.5M3 21v-6m0 0 2.77-.693a9 9 0 0 1 6.208.682l.108.054a9 9 0 0 0 6.086.71l3.114-.732a48.524 48.524 0 0 1-.005-10.499l-3.11.732a9 9 0 0 1-6.085-.711l-.108-.054a9 9 0 0 0-6.208-.682L3 4.5M3 15V4.5" />
        </svg>

        <span class="">回報問題</span>
    </span>
</button>

<script>
    function initReportIssueButton() {
        const btn = document.getElementById('report-issue-btn');
        if (!btn) return;

        let selectedText = '';
        let hideTimeout: ReturnType<typeof setTimeout> | null = null;
        const MAX_TEXT_LENGTH = 500;

        // 取得網站根目錄
        const baseUrl = document.querySelector('meta[name="base-url"]')?.getAttribute('content') 
            || '/laws';

        // 判斷是否為桌面版（toc breakpoint = 1372px）
        const tocBreakpoint = 1372;

        function showBtn() {
            if (hideTimeout) {
                clearTimeout(hideTimeout);
                hideTimeout = null;
            }
            if (window.innerWidth >= tocBreakpoint) {
                // 電腦版：直接顯示（移除 hidden）
                btn.classList.remove('toc:hidden');
            } else {
                // 手機版：滑入動畫（從左側滑入，與 TOC 按鈕相同）
                btn.classList.remove('-translate-x-full');
                btn.classList.add('translate-x-0');
            }
        }

        function hideBtn() {
            if (window.innerWidth >= tocBreakpoint) {
                // 電腦版：直接隱藏
                btn.classList.add('toc:hidden');
            } else {
                // 手機版：滑出動畫（滑回左側）
                btn.classList.remove('translate-x-0');
                btn.classList.add('-translate-x-full');
            }
        }

        // 檢查選取範圍是否在 .regulation-content 或 .regulation-amendment 內
        function isSelectionInRegulationContent(selection: Selection): boolean {
            if (!selection.rangeCount) return false;
            const range = selection.getRangeAt(0);
            const container = range.commonAncestorContainer;
            const element = container.nodeType === Node.TEXT_NODE 
                ? container.parentElement 
                : container as Element;
            return !!element?.closest('.regulation-content, .regulation-amendment');
        }

        // 監聽文字選取變化
        function handleSelectionChange() {
            const selection = window.getSelection();
            if (!selection || selection.isCollapsed || !selection.toString().trim()) {
                // 延遲隱藏，給使用者時間點擊按鈕
                if (hideTimeout) clearTimeout(hideTimeout);
                hideTimeout = setTimeout(() => hideBtn(), 1500);
                return;
            }

            if (isSelectionInRegulationContent(selection)) {
                selectedText = selection.toString().trim();
                if (selectedText.length > MAX_TEXT_LENGTH) {
                    selectedText = selectedText.substring(0, MAX_TEXT_LENGTH) + '…';
                }
                showBtn();
            }
        }

        // 點擊按鈕後導向 contact-us 頁面
        btn.onclick = (e) => {
            e.preventDefault();
            
            const sourceUrl = window.location.href;
            const reportContent = `【來源】${sourceUrl}\n【條文內容】\n${selectedText}\n【問題描述】\n(請在此填寫您發現的問題或建議)`;
            
            const params = new URLSearchParams({
                'report': reportContent,
            });

            window.open(
                `${baseUrl}/information/contact-us?${params.toString()}`,
                '_blank'
            );
        };

        // 綁定 selectionchange 事件（避免重複綁定）
        if ((window as any)._reportIssueHandler) {
            document.removeEventListener('selectionchange', (window as any)._reportIssueHandler);
        }
        (window as any)._reportIssueHandler = handleSelectionChange;
        document.addEventListener('selectionchange', (window as any)._reportIssueHandler);
    }

    // === 對接 Astro 生命週期 ===
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReportIssueButton);
    } else {
        initReportIssueButton();
    }
    document.addEventListener('astro:page-load', () => {
        if (document.readyState !== 'loading') initReportIssueButton();
    });
</script>
