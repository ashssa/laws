37f)"><g transform="matrix(1, 0, 0, 1, 183, 3)"><g clip-path="url(#f73876a260)"><g clip-path="url(#5c1ea36545)"><g clip-path="url(#6c0e766d36)"><path fill="currentColor" d="M 30.738281 175.207031 L 0.753906 175.207031 L 0.753906 -0.0117188 L 30.738281 -0.0117188 Z M 30.738281 175.207031 " fill-opacity="1" fill-rule="nonzero"></path></g></g></g></g></g></g><g clip-path="url(#4bbdb12556)"><g transform="matrix(1, 0, 0, 1, 77, 3)"><g clip-path="url(#8e05adc6b7)"><g clip-path="url(#7451250d61)"><path fill="currentColor" d="M 121.746094 0.0117188 L 121.746094 29.996094 L 0.0546875 29.996094 L 0.0546875 0.0117188 Z M 121.746094 0.0117188 " fill-opacity="1" fill-rule="nonzero"></path></g></g></g></g><g clip-path="url(#e9bcd5c4a0)"><g transform="matrix(1, 0, 0, 1, 77, 148)"><g clip-path="url(#202da461ee)"><g clip-path="url(#489b94f8ef)"><path fill="currentColor" d="M 121.746094 0.230469 L 121.746094 30.214844 L 0.0546875 30.214844 L 0.0546875 0.230469 Z M 121.746094 0.230469 " fill-opacity="1" fill-rule="nonzero"></path></g></g></g></g></svg>
                        法規系統維運小組
                    </div>
                    發布
                </div>
            </div>

            <!-- 文章內容 -->
            <div class="blog-post-content">
                <slot />
            </div>


        </article>
    </main>

    <ScrollToTop />
    <Footer />
    <SearchModal />

    <script>
        // 建立圖片環境光暈效果（Ambient Blur）
        function setupImageBlurs() {
            document.querySelectorAll('.blog-post-content img').forEach(img => {
                // 如果已經包裹過，或是沒有 src，則跳過
                if (img.closest('.ambient-image-wrapper') || !img.src) return;
                
                const parent = img.parentNode;
                
                // 建立外層容器
                const wrapper = document.createElement('div');
                wrapper.className = 'ambient-image-wrapper relative flex justify-center items-center w-full my-4 rounded-box border-2 border-base-200/80 overflow-hidden';
                // 讓容器保持原圖片的拉伸寬度，但內部用 flex 居中
                
                // 建立霧化背景層
                const blurBg = document.createElement('div');
                blurBg.className = 'absolute inset-[-50px] z-0 opacity-15 blur-xl mask-x-from-80% mask-x-to-100% bg-cover bg-center';
                blurBg.style.backgroundImage = `url(${img.src})`;
                
                // 調整原圖片樣式
                // 將圖片原本的 full width 與 border 移除，讓其自然呈現比例
                img.className = 'relative z-10 w-auto max-w-full max-h-[50vh] object-contain border-none my-0';
                
                // 將元素組合
                parent.insertBefore(wrapper, img);
                wrapper.appendChild(blurBg);
                wrapper.appendChild(img);
            });
        }

        // 初始化
        document.addEventListener('DOMContentLoaded', setupImageBlurs);
        // 如果有使用 ViewTransitions，也需要在頁面切換後執行
        document.addEventListener('astro:page-load', setupImageBlurs);
    </script>
</body>
</html>

<style>
    @reference "../styles/global.css";

    .main-content {
        margin: 2rem auto;
        padding-left: 1.5rem;
        padding-right: 1.5rem;
    }
    .blog-post {
        @apply max-w-3xl mx-auto;
    }
    .blog-post-title {
        @apply mb-2;
    }
    .blog-post-description {
        @apply text-base-content/70 text-sm;
    }
    .blog-post-content {
        @apply max-w-none;
    }
</style>
